{
  "name": "akhorkhel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-packs": "tsx tools/validate-packs.ts",
    "validate-packs:release": "tsx tools/validate-packs.ts --release",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate-packs",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@shopify/react-native-skia": "2.14.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "1.0.1",
    "react-native-gesture-handler": "3.5.0",
    "react-native-google-mobile-ads": "17.4.0",
    "react-native-html-to-pdf": "1.3.0",
    "react-native-in-app-review": "4.4.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-share": "12.3.1",
    "react-native-worklets": "0.14.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@babel/runtime": "7.29.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "9.39.5",
    "harfbuzzjs": "1.6.4",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "test-renderer": "1.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
